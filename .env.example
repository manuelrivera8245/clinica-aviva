# =============================================================================
# Clínica Aviva — Plantilla de Variables de Entorno
# =============================================================================
#
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a `.env`:
#        cp .env.example .env       (Linux / macOS)
#        copy .env.example .env     (Windows CMD)
#
#   2. Rellena cada valor con tus credenciales locales de desarrollo.
#
#   3. NUNCA subas el archivo `.env` al repositorio. Ya está en el .gitignore.
#      Solo este archivo (.env.example) con valores vacíos puede commitearse.
#
# Spring Boot resuelve estas variables automáticamente mediante Relaxed Binding:
#   SPRING_DATASOURCE_URL  →  spring.datasource.url
#   APP_JWT_SECRET         →  app.jwt.secret
#   (etc.)
# =============================================================================


# -----------------------------------------------------------------------------
# Base de Datos — MySQL
# -----------------------------------------------------------------------------

# URL de conexión JDBC. Ajusta el host/puerto si usas Docker u otro entorno.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/clinica_aviva?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true

# Usuario de MySQL con permisos sobre la BD 'clinica_aviva'
SPRING_DATASOURCE_USERNAME=

# Contraseña del usuario MySQL
SPRING_DATASOURCE_PASSWORD=

# Tamaño del pool de conexiones HikariCP (opcional, valor por defecto: 10)
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10


# -----------------------------------------------------------------------------
# Seguridad — JSON Web Token (JWT)
# -----------------------------------------------------------------------------

# Clave secreta para firmar los tokens JWT.
# REQUISITO: mínimo 256 bits (64 caracteres hexadecimales o equivalente en Base64).
# Puedes generar una con: openssl rand -hex 64
APP_JWT_SECRET=

# Tiempo de expiración del token en milisegundos.
# 86400000 = 24 horas | 3600000 = 1 hora
APP_JWT_EXPIRATION=86400000


# -----------------------------------------------------------------------------
# Spring Boot — Configuración General
# -----------------------------------------------------------------------------

# Perfil activo de Spring. Opciones: dev | staging | prod
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor embebido (Tomcat). Por defecto: 8080
# SERVER_PORT=8080

# Nivel de logging (opcional)
# LOGGING_LEVEL_COM_CLINICAAVIVA=DEBUG


# -----------------------------------------------------------------------------
# Frontend (informativo — no es leído por Spring Boot)
# -----------------------------------------------------------------------------
# La URL base de la API. Configúrala también en:
# frontend/src/environments/environment.ts → apiUrl
# API_BASE_URL=http://localhost:8080/api
